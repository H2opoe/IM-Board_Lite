{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IM-Board",
  "mainBinaryName": "IM-Board",
  "version": "3.0.0",
  "identifier": "com.local.im-board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:windows-deps && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IM-Board 聊天汇总看板",
        "width": 1320,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../runtime/llama.cpp/*/win-cpu-x64/**/*",
      "icons/icon-light.png",
      "icons/icon-dark.png"
    ]
  }
}
