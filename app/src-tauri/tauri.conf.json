{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IM-Board",
  "mainBinaryName": "IM-Board",
  "version": "2.1.2-lite",
  "identifier": "com.local.im-board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IM-Board·聊天汇总看板",
        "width": 1320,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [
      "icons/icon-light.png",
      "icons/icon-dark.png"
    ]
  }
}
