{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IM-Board",
  "mainBinaryName": "IM-Board",
  "version": "2.2.4-lite",
  "identifier": "com.local.im-board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:macos-deps && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IM-Board·聊天汇总看板",
        "width": 1320,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../runtime/llama.cpp/*/darwin-arm64/**/*",
      "../runtime/llama.cpp/*/darwin-x64/**/*",
      "icons/icon-light.png",
      "icons/icon-dark.png"
    ],
    "macOS": {
      "bundleName": "IM-Board",
      "bundleVersion": "22200"
    }
  }
}
