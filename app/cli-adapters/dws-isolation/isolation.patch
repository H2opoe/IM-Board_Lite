+//go:build windows
+
+package keychain
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"golang.org/x/sys/windows/registry"
+	"os"
+	"testing"
+)
+
+func TestIMBoardWindowsAllTokenSlotsAreIsolated(t *testing.T) {
+	namespaces := make([]string, 2)
+	for i := range namespaces {
+		bytes := make([]byte, 32)
+		if _, err := rand.Read(bytes); err != nil {
+			t.Fatal(err)
+		}
+		namespaces[i] = hex.EncodeToString(bytes)
+	}
+	defer func() {
+		for _, ns := range namespaces {
+			os.Setenv(imBoardNamespaceEnv, ns)
+			path, _ := registryPathForService("fixture-service")
+			_ = registry.DeleteKey(registry.CURRENT_USER, path)
+		}
+	}()
+	for i, ns := range namespaces {
+		t.Setenv(imBoardNamespaceEnv, ns)
+		for _, slot := range []string{"auth-token", "auth-token:fixture-corp"} {
+			value := "fixture-" + namespaces[i]
+			if err := platformSet("fixture-service", slot, value); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	for i, ns := range namespaces {
+		os.Setenv(imBoardNamespaceEnv, ns)
+		for _, slot := range []string{"auth-token", "auth-token:fixture-corp"} {
+			value, err := platformGet("fixture-service", slot)
+			if err != nil || value != "fixture-"+namespaces[i] {
+				t.Fatalf("cross-account result: %v", err)
+			}
+		}
+	}
+	os.Unsetenv(imBoardNamespaceEnv)
+	if _, err := platformGet("fixture-service", "auth-token"); err == nil {
+		t.Fatal("missing namespace allowed read")
+	}
+	if err := platformSet("fixture-service", "auth-token", "fixture"); err == nil {
+		t.Fatal("missing namespace allowed write")
+	}
+	if err := platformRemove("fixture-service", "auth-token"); err == nil {
+		t.Fatal("missing namespace allowed removal")
+	}
+}
+
+func TestIMBoardWindowsMissingNamespaceRejectsNewCredentialOperations(t *testing.T) {
+	t.Setenv(imBoardNamespaceEnv, "")
+	if err := platformValidateAuthTokenEntries("fixture"); err == nil {
+		t.Fatal("validation used a global registry")
+	}
+	if err := registryRemoveAuthTokenEntries("fixture"); err == nil {
+		t.Fatal("token cleanup used a global registry")
+	}
+	if err := registryRemoveAccountEntriesWithPrefixes("fixture", []string{"auth-"}); err == nil {
+		t.Fatal("account cleanup used a global registry")
+	}
+}
