+// IM-Board Windows adaptation. This helper performs no OS access.
+package keychain
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+const imBoardNamespaceEnv = "IM_BOARD_DWS_NAMESPACE"
+
+var imBoardNamespacePattern = regexp.MustCompile(`^[0-9a-fA-F]{64}$`)
+
+func imBoardNamespaceRoot(namespace string) (string, error) {
+	if !imBoardNamespacePattern.MatchString(namespace) {
+		return "", fmt.Errorf("IM-Board DWS requires an explicit 64-hex account namespace")
+	}
+	return `Software\IMBoard\DwsCli\Profiles\` + strings.ToLower(namespace), nil
+}
