+package keychain
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestIMBoardNamespaceRejectsMissingAndUnsafeInputs(t *testing.T) {
+	for _, value := range []string{"", "..", `C:\profile`, strings.Repeat("a", 63), strings.Repeat("a", 65), strings.Repeat("a", 63) + "/", " " + strings.Repeat("a", 64)} {
+		if _, err := imBoardNamespaceRoot(value); err == nil {
+			t.Fatalf("accepted invalid namespace %q", value)
+		}
+	}
+}
+func TestIMBoardNamespacesAreDistinctAndNeverUseGlobalDWSRoot(t *testing.T) {
+	a, err := imBoardNamespaceRoot(strings.Repeat("A", 64))
+	if err != nil {
+		t.Fatal(err)
+	}
+	same, _ := imBoardNamespaceRoot(strings.Repeat("a", 64))
+	b, _ := imBoardNamespaceRoot(strings.Repeat("b", 64))
+	if a != same || a == b || !strings.HasPrefix(a, `Software\IMBoard\DwsCli\Profiles\`) || strings.Contains(a, `Software\DwsCli\keychain`) {
+		t.Fatalf("bad namespace mapping: %s", a)
+	}
+}
