+package chatmsg
+
+import "testing"
+
+func TestIMBoardProjectionPreservesConversationFacts(t *testing.T) {
+	for _, single := range []bool{true, false} {
+		row := ProjectMessageV1(map[string]any{"openMessageId": "fixture-msg", "openConversationId": "fixture-chat", "singleChat": single, "conversationTitle": "fixture-name"}, false)
+		if row["singleChat"] != single || row["conversationTitle"] != "fixture-name" {
+			t.Fatal("conversation facts lost")
+		}
+	}
+	row := ProjectMessageV1(map[string]any{}, false)
+	if _, exists := row["singleChat"]; exists {
+		t.Fatal("invented type")
+	}
