{
  "name": "im-board",
  "private": true,
  "version": "2.1.3-lite",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "prepare:macos-deps": "node scripts/prepare-macos-deps.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev:real": "/bin/zsh -lc '. \"$HOME/.cargo/env\" && npm run prepare:macos-deps && IM_BOARD_BRIDGE_ROOT=\"$PWD/bridges\" npm exec tauri -- dev'",
    "debug:wechat:discover": "bridges/wechat/bridge_main discover --format json",
    "debug:env": "/bin/zsh -lc '. \"$HOME/.cargo/env\" && node scripts/check-debug-env.mjs'"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
