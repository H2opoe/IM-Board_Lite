#!/usr/bin/env python3
"""Development WeChat bridge for IM-Board.

The bridge keeps the app contract stable while delegating the actual local
database work to the user's bundled or local wechat-cli implementation.
"""

from __future__ import annotations

import argparse
import glob
import hashlib
import json
import os
import plistlib
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import platform
from pathlib import Path
from typing import Any


HEX_SECRET_RE = re.compile(r"\b[a-fA-F0-9]{48,}\b")
APP_BUNDLE_RE = re.compile(r"(com\.tencent\.[A-Za-z0-9_.-]+)$")
WECHAT_PROCESS_RE = re.compile(r"(WeChat|WeChatAppEx|wxocr|wxplayer|wxutility|微信)", re.IGNORECASE)
WECHAT_ARG_RE = re.compile(r"--([A-Za-z0-9_-]+)=(\"[^\"]*\"|'[^']*'|\\.|[^\s]+)")


def bridge_dir() -> Path:
    return Path(__file__).resolve().parent


def app_dir() -> Path:
    return bridge_dir().parents[1]


def load_local_env() -> None:
    for env_file in [app_dir() / ".env.local", app_dir() / ".env", bridge_dir() / ".env.local"]:
        if not env_file.exists():
            continue
        for raw_line in env_file.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip().strip('"').strip("'")
            os.environ.setdefault(key, os.path.expanduser(value))
    ensure_cli_path()


def ensure_cli_path() -> None:
    home = str(Path.home())
    entries = [
        str(Path.home() / ".local" / "bin"),
        *sorted(glob.glob(f"{home}/.nvm/versions/node/*/bin"), reverse=True),
        "/opt/homebrew/bin",
        "/opt/homebrew/sbin",
        "/usr/local/bin",
        "/usr/local/sbin",
        "/usr/bin",
        "/bin",
        "/usr/sbin",
        "/sbin",
    ]
    existing = os.environ.get("PATH", "")
    parts = [part for part in existing.split(os.pathsep) if part]
    for entry in reversed(entries):
        if entry and Path(entry).exists() and entry not in parts:
            parts.insert(0, entry)
    os.environ["PATH"] = os.pathsep.join(parts)


def sanitize(text: str) -> str:
    return HEX_SECRET_RE.sub("<redacted>", text)


def validate_sudo_password(password: str) -> tuple[bool, str]:
    if not password:
        return True, ""
    try:
        proc = subprocess.run(
            ["sudo", "-S", "-p", "", "-v"],
            input=password + "\n",
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=15,
        )
    except subprocess.TimeoutExpired:
        return False, "sudo 密码验证超时，请确认输入的是当前 macOS 用户密码。"
    except FileNotFoundError:
        return False, "系统 sudo 命令不可用。"
    if proc.returncode != 0:
        detail = sanitize("\n".join([proc.stderr or "", proc.stdout or ""]).strip())
        return False, detail or "sudo 密码验证失败，请确认输入的是当前 macOS 用户密码。"
    return True, ""


def envelope(ok: bool, data: Any = None, warnings: list[str] | None = None, error: dict[str, Any] | None = None, **meta: Any) -> int:
    print(
        json.dumps(
            {
                "ok": ok,
                "data": [] if data is None and ok else data,
                "warnings": warnings or [],
                "error": error,
                "meta": {"platform": "wechat", **meta},
            },
            ensure_ascii=False,
        )
    )
    return 0 if ok else 1


def parse_kv_arg(command: str, key: str) -> str:
    prefix = f"--{key}="
    start = command.find(prefix)
    if start < 0:
        return ""
    value = command[start + len(prefix) :]
    next_option = value.find(" --")
    if next_option >= 0:
        value = value[:next_option]
    return value.strip().strip('"')


def parse_process_args(command: str) -> dict[str, str]:
    args: dict[str, str] = {}
    for match in WECHAT_ARG_RE.finditer(command):
        value = match.group(2).strip()
        if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
            value = value[1:-1]
        args[match.group(1)] = value
    return args


def strip_team_prefix(bundle_id: str) -> str:
    match = APP_BUNDLE_RE.search(bundle_id)
    return match.group(1) if match else bundle_id


def app_path_from_command(command: str) -> str:
    marker = ".app/Contents/"
    if marker not in command:
        return ""
    before_marker = command.split(marker, 1)[0]
    if before_marker.startswith("/"):
        return before_marker + ".app"
    start = before_marker.find("/")
    if start >= 0:
        return before_marker[start:] + ".app"
    return ""


def is_wechat_app_path(app_path: str) -> bool:
    app_name = Path(app_path).name.lower()
    return "wechat" in app_name or "微信" in app_name


def read_bundle_id(app_path: str) -> str:
    if not app_path:
        return ""
    info_path = Path(app_path) / "Contents" / "Info.plist"
    if not info_path.exists():
        return ""
    try:
        with info_path.open("rb") as handle:
            value = plistlib.load(handle).get("CFBundleIdentifier", "")
        return strip_team_prefix(str(value)) if value else ""
    except Exception:
        return ""


def requires_app_management_permission(app_path: str) -> bool:
    if not app_path:
        return False
    expanded = os.path.abspath(os.path.expanduser(app_path))
    roots = ["/Applications/", str(Path.home() / "Applications") + "/"]
    return any(expanded.startswith(root) for root in roots)


def read_wechat_signing_state(app_path: str) -> dict[str, Any]:
    state: dict[str, Any] = {
        "signatureStatus": "unknown",
        "hasGetTaskAllow": False,
        "needsResign": True,
        "requiresAppManagementPermission": requires_app_management_permission(app_path),
    }
    if not app_path:
        return state

    try:
        signature_proc = subprocess.run(
            ["codesign", "-dv", app_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            timeout=10,
        )
        signature_output = "\n".join([signature_proc.stderr or "", signature_proc.stdout or ""])
        if signature_proc.returncode != 0:
            state["signatureStatus"] = "unreadable"
            state["signingReadError"] = sanitize(signature_output.strip())
        elif "Signature=adhoc" in signature_output:
            state["signatureStatus"] = "adhoc"
        elif "Authority=" in signature_output or "TeamIdentifier=" in signature_output:
            state["signatureStatus"] = "signed"
    except Exception as exc:
        state["signatureStatus"] = "unreadable"
        state["signingReadError"] = sanitize(str(exc))

    try:
        ent_proc = subprocess.run(
            ["codesign", "-d", "--entitlements", ":-", app_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=10,
        )
        entitlements = ent_proc.stdout or b""
        has_get_task_allow = False
        if entitlements.strip():
            try:
                parsed = plistlib.loads(entitlements)
                has_get_task_allow = bool(parsed.get("com.apple.security.get-task-allow"))
            except Exception:
                ent_text = entitlements.decode("utf-8", errors="replace")
                has_get_task_allow = (
                    "com.apple.security.get-task-allow" in ent_text
                    and ("<true/>" in ent_text or "true" in ent_text.lower())
                )
        state["hasGetTaskAllow"] = has_get_task_allow
        state["needsResign"] = not has_get_task_allow
    except Exception as exc:
        state["signingReadError"] = sanitize(str(exc))

    return state


def run_process(command: list[str], **kwargs: Any) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        **kwargs,
    )


def process_output(proc: subprocess.CompletedProcess[str]) -> str:
    return sanitize("\n".join([proc.stderr or "", proc.stdout or ""]).strip())


def ensure_plist_dict(path: str) -> None:
    plist_path = Path(path)
    try:
        if plist_path.exists() and plist_path.stat().st_size > 0:
            plistlib.loads(plist_path.read_bytes())
            return
    except Exception:
        pass
    with plist_path.open("wb") as handle:
        plistlib.dump({}, handle)


def plist_has_get_task_allow(path: str) -> bool:
    try:
        parsed = plistlib.loads(Path(path).read_bytes())
        return bool(parsed.get("com.apple.security.get-task-allow"))
    except Exception:
        text = Path(path).read_text(encoding="utf-8", errors="replace") if Path(path).exists() else ""
        return (
            "com.apple.security.get-task-allow" in text
            and ("<true/>" in text or "true" in text.lower())
        )


def resign_wechat_with_merged_entitlements(app_path: str, use_sudo: bool) -> tuple[bool, str]:
    if not app_path:
        return True, ""
    sudo_prefix = ["sudo", "-n"] if use_sudo else []
    plistbuddy = "/usr/libexec/PlistBuddy"
    with tempfile.TemporaryDirectory(prefix="imboard-wechat-sign-") as temp_dir:
        entitlements_path = str(Path(temp_dir) / "wechat_entitlements.plist")

        extract_proc = run_process(["codesign", "-d", "--entitlements", entitlements_path, app_path], timeout=15)
        if extract_proc.returncode != 0:
            return False, process_output(extract_proc) or "无法提取微信原始 entitlements。"
        ensure_plist_dict(entitlements_path)

        add_proc = run_process(
            [plistbuddy, "-c", "Add :com.apple.security.get-task-allow bool true", entitlements_path],
            timeout=10,
        )
        if add_proc.returncode != 0:
            set_proc = run_process(
                [plistbuddy, "-c", "Set :com.apple.security.get-task-allow true", entitlements_path],
                timeout=10,
            )
            if set_proc.returncode != 0:
                return False, process_output(set_proc) or process_output(add_proc) or "无法合并 get-task-allow entitlement。"

        sign_proc = run_process(
            [*sudo_prefix, "codesign", "--force", "--sign", "-", "--entitlements", entitlements_path, app_path],
            timeout=120,
        )
        if sign_proc.returncode != 0:
            return False, process_output(sign_proc) or "codesign 使用合并 entitlements 重签微信失败。"

        deep_proc = run_process(
            [*sudo_prefix, "codesign", "--force", "--deep", "--sign", "-", app_path],
            timeout=120,
        )
        if deep_proc.returncode != 0:
            return False, process_output(deep_proc) or "codesign deep 修复微信整包签名失败。"

        final_sign_proc = run_process(
            [*sudo_prefix, "codesign", "--force", "--sign", "-", "--entitlements", entitlements_path, app_path],
            timeout=120,
        )
        if final_sign_proc.returncode != 0:
            return False, process_output(final_sign_proc) or "codesign deep 后补写 get-task-allow 失败。"

        verify_path = str(Path(temp_dir) / "wechat_entitlements_verified.plist")
        verify_proc = run_process(["codesign", "-d", "--entitlements", verify_path, app_path], timeout=15)
        if verify_proc.returncode != 0:
            return False, process_output(verify_proc) or "无法检查微信最终 entitlements。"
        if plist_has_get_task_allow(verify_path):
            return True, ""
        return False, "微信重签后未保留 com.apple.security.get-task-allow。"


def restart_wechat_app(app_path: str, bundle_id: str = "") -> tuple[bool, str]:
    if platform.system() != "Darwin" or not app_path:
        return True, ""
    errors: list[str] = []
    executable_path = str(Path(app_path) / "Contents" / "MacOS" / "WeChat")
    if not force_quit_wechat_processes(app_path, bundle_id):
        errors.append("已强制退出微信，但仍检测到微信进程。")

    launch_commands = [
        ["open", "-n", app_path],
        ["open", app_path],
    ]
    if bundle_id:
        launch_commands.append(["open", "-b", bundle_id])
    if Path(executable_path).exists():
        launch_commands.append([executable_path])

    for index, command in enumerate(launch_commands):
        if command[0] == executable_path:
            try:
                subprocess.Popen(
                    command,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            except OSError as exc:
                errors.append(str(exc))
                continue
        else:
            open_proc = run_process(command, timeout=15)
            if open_proc.returncode != 0:
                errors.append(process_output(open_proc))
                continue
        if wait_for_wechat_process_start(app_path, bundle_id):
            return True, ""
        errors.append(f"启动命令已执行但未检测到微信进程：{' '.join(command)}")
        if index == 0:
            time.sleep(1.0)

    return False, "；".join([error for error in errors if error]) or "无法自动重新打开微信。"


def wait_for_wechat_process_exit(app_path: str, bundle_id: str, timeout_seconds: float = 8.0) -> bool:
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        if not is_wechat_process_running(app_path, bundle_id):
            return True
        time.sleep(0.4)
    return False


def wait_for_wechat_process_start(app_path: str, bundle_id: str, timeout_seconds: float = 15.0) -> bool:
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        if is_wechat_process_running(app_path, bundle_id):
            return True
        time.sleep(0.5)
    return False


def is_wechat_process_running(app_path: str, bundle_id: str) -> bool:
    return bool(find_wechat_processes(app_path, bundle_id))


def find_wechat_processes(app_path: str, bundle_id: str) -> list[int]:
    app_path = app_path.rstrip("/")
    current_pid = os.getpid()
    pids: list[int] = []
    for pid, command in run_ps():
        if pid == current_pid:
            continue
        if not WECHAT_PROCESS_RE.search(command):
            continue
        if app_path and app_path in command:
            pids.append(pid)
            continue
        if bundle_id and command_has_bundle_id(command, bundle_id):
            pids.append(pid)
    return sorted(set(pids))


def command_has_bundle_id(command: str, bundle_id: str) -> bool:
    if not bundle_id:
        return False
    pattern = rf"(?<![A-Za-z0-9_.-])(?:[A-Z0-9]{{10}}\.)?{re.escape(bundle_id)}(?![A-Za-z0-9_.-])"
    return re.search(pattern, command) is not None


def force_quit_wechat_processes(app_path: str, bundle_id: str) -> bool:
    for pid in find_wechat_processes(app_path, bundle_id):
        try:
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            continue
    return wait_for_wechat_process_exit(app_path, bundle_id, timeout_seconds=2.0)


def default_xwechat_files(bundle_id: str) -> str:
    if not bundle_id:
        return ""
    return str(Path.home() / "Library" / "Containers" / bundle_id / "Data" / "Documents" / "xwechat_files")


def iso_mtime(path: Path) -> str:
    try:
        return time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(path.stat().st_mtime))
    except OSError:
        return ""


def db_dir_stats(db_dir: Path) -> dict[str, Any]:
    session_db = db_dir / "session" / "session.db"
    message_dir = db_dir / "message"
    contact_db = db_dir / "contact" / "contact.db"
    db_count = len(list(db_dir.rglob("*.db"))) if db_dir.exists() else 0
    message_db_count = len(list(message_dir.glob("message_*.db"))) if message_dir.exists() else 0
    return {
        "hasSessionDb": session_db.exists(),
        "hasMessageDir": message_dir.is_dir(),
        "hasMessageDb": message_db_count > 0,
        "hasContactDb": contact_db.exists(),
        "dbCount": db_count,
        "messageDbCount": message_db_count,
    }


def score_db_dir(db_dir: Path) -> tuple[int, str, dict[str, Any]]:
    stats = db_dir_stats(db_dir)
    score = 0
    if stats["hasSessionDb"]:
        score += 45
    if stats["hasMessageDir"]:
        score += 25
    if stats["hasMessageDb"]:
        score += 20
    if stats["hasContactDb"]:
        score += 10
    score += min(int(stats["dbCount"]), 20)
    confidence = "high" if stats["hasSessionDb"] and stats["hasMessageDir"] and stats["hasContactDb"] else "low"
    return score, confidence, stats


def find_candidate_db_dirs(xwechat_files: str) -> list[dict[str, Any]]:
    root = Path(os.path.expanduser(xwechat_files))
    if not root.exists():
        return []
    candidates: list[dict[str, Any]] = []
    for path in root.glob("*/db_storage"):
        if not path.is_dir():
            continue
        score, confidence, stats = score_db_dir(path)
        candidates.append(
            {
                "path": str(path),
                "score": score,
                "confidence": confidence,
                "valid": confidence == "high",
                "lastModified": iso_mtime(path),
                **stats,
            }
        )
    candidates.sort(key=lambda item: (item["score"], item["lastModified"]), reverse=True)
    return candidates


def run_ps() -> list[tuple[int, str]]:
    proc = subprocess.run(
        ["ps", "axww", "-o", "pid=,command="],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        return []
    rows: list[tuple[int, str]] = []
    for line in proc.stdout.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        pid_text, _, command = stripped.partition(" ")
        if pid_text.isdigit():
            rows.append((int(pid_text), command))
    return rows


def newest_db_dir(xwechat_files: str) -> str:
    root = Path(os.path.expanduser(xwechat_files))
    if not root.exists():
        return ""
    candidates = [path for path in root.glob("*/db_storage") if path.is_dir()]
    if not candidates:
        return ""
    candidates.sort(key=lambda path: path.stat().st_mtime, reverse=True)
    return str(candidates[0])


def stable_candidate_id(bundle_id: str, app_path: str, db_dir: str) -> str:
    digest = hashlib.sha1(f"{bundle_id}|{app_path}|{db_dir}".encode("utf-8")).hexdigest()[:12]
    return f"wechat_{digest}"


def discover_candidates() -> list[dict[str, Any]]:
    instances: dict[str, dict[str, Any]] = {}

    for pid, command in run_ps():
        if not WECHAT_PROCESS_RE.search(command):
            continue
        app_path = app_path_from_command(command)
        if not app_path:
            continue
        if not is_wechat_app_path(app_path) and "--wechat-files-path=" not in command:
            continue
        details = instances.setdefault(
            app_path,
            {
                "appPath": app_path,
                "pid": 0,
                "relatedPids": [],
                "bundleId": "",
                "dataDir": "",
                "wmpfRootDir": "",
            },
        )
        details["relatedPids"].append(pid)
        parsed_args = parse_process_args(command)
        raw_bundle_id = parse_kv_arg(command, "bundle-id") or parsed_args.get("bundle-id", "")
        wechat_files_path = parse_kv_arg(command, "wechat-files-path") or parsed_args.get("wechat-files-path", "")
        wmpf_root_dir = parse_kv_arg(command, "wmpf_root_dir") or parsed_args.get("wmpf_root_dir", "")
        if command.endswith("/Contents/MacOS/WeChat") or "/Contents/MacOS/WeChat " in command:
            details["pid"] = details["pid"] or pid
        if raw_bundle_id:
            details["bundleId"] = strip_team_prefix(raw_bundle_id)
        if wechat_files_path:
            details["dataDir"] = wechat_files_path
        if wmpf_root_dir:
            details["wmpfRootDir"] = wmpf_root_dir

    candidates: list[dict[str, Any]] = []
    for app_path, details in sorted(instances.items()):
        bundle_id = details.get("bundleId") or read_bundle_id(app_path)
        data_dir = details.get("dataDir") or default_xwechat_files(bundle_id)
        db_candidates = find_candidate_db_dirs(data_dir)
        db_dir = db_candidates[0]["path"] if db_candidates else ""
        pid = details.get("pid") or (details.get("relatedPids") or [0])[0]
        last_modified = db_candidates[0]["lastModified"] if db_candidates else ""
        signing_state = read_wechat_signing_state(app_path)
        candidates.append(
            {
                "id": stable_candidate_id(bundle_id, app_path, db_dir),
                "platform": "wechat",
                "label": "微信",
                "pid": pid,
                "relatedPids": sorted(set(details.get("relatedPids", []))),
                "bundleId": bundle_id,
                "containerId": bundle_id,
                "appPath": app_path,
                "dataDir": data_dir,
                "wechatFilesPath": data_dir,
                "dbDir": db_dir,
                "candidateDbDirs": db_candidates,
                "running": True,
                "lastModified": last_modified,
                "confidence": db_candidates[0]["confidence"] if db_candidates else "low",
                **signing_state,
            }
        )
    return candidates


def query_cli(config: dict[str, Any] | None = None, explicit: str | None = None) -> str:
    configured_candidates = [
        explicit,
        config.get("cliPath") if isinstance(config, dict) else None,
        os.environ.get("IMD_WECHAT_QUERY_CLI"),
    ]
    if os.name == "nt":
        for configured in configured_candidates:
            if isinstance(configured, str) and configured.strip():
                return os.path.expanduser(configured.strip())
        return shutil.which("wechat-cli") or "wechat-cli"

    candidates: list[str] = []
    for configured in configured_candidates:
        if isinstance(configured, str) and configured.strip():
            candidates.append(os.path.expanduser(configured.strip()))
    bundled_cli = Path(sys.executable).resolve().parent / "wechat-cli"
    if bundled_cli.exists():
        candidates.append(str(bundled_cli))
    candidates.extend(str(path) for path in bundled_runtime_cli_candidates())
    local_wrapper = Path.home() / ".local" / "bin" / "wechat-cli-work"
    if local_wrapper.exists():
        candidates.append(str(local_wrapper))
    path_cli = shutil.which("wechat-cli")
    if path_cli:
        candidates.append(path_cli)

    for candidate in dedupe_cli_candidates(candidates):
        if supports_profile_cli(candidate):
            return candidate
    return str(bundled_cli if bundled_cli.exists() else local_wrapper)


def bundled_runtime_cli_candidates() -> list[Path]:
    machine = platform.machine().lower()
    arch = "darwin-arm64" if machine in {"arm64", "aarch64"} else "darwin-x64"
    roots = [
        bridge_dir().parents[1] / "runtime",
        bridge_dir().parents[2] / "runtime" if len(bridge_dir().parents) > 2 else bridge_dir() / "runtime",
        Path.cwd() / "runtime",
        Path.cwd().parent / "runtime",
    ]
    return [root / "python" / "20260414" / arch / "python" / "bin" / "wechat-cli" for root in roots]


def dedupe_cli_candidates(candidates: list[str]) -> list[str]:
    seen: set[str] = set()
    result: list[str] = []
    for candidate in candidates:
        key = str(Path(candidate).expanduser())
        if key in seen:
            continue
        seen.add(key)
        result.append(key)
    return result


def supports_profile_cli(candidate: str) -> bool:
    try:
        proc = subprocess.run(
            [candidate, "init", "--help"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    help_text = f"{proc.stdout}\n{proc.stderr}"
    return "--config" in help_text and "--keys-file" in help_text


def profile_paths(args: argparse.Namespace) -> dict[str, str]:
    profile_id = args.profile_id or "wechat_debug"
    config_path = Path(os.path.expanduser(args.config or "")).resolve() if args.config else app_dir() / ".debug" / profile_id / "config.json"
    keys_path = Path(os.path.expanduser(args.keys_file or "")).resolve() if args.keys_file else config_path.parent / "all_keys.json"
    cache_dir = Path(os.path.expanduser(os.environ.get("TMPDIR", ""))).parent if os.environ.get("TMPDIR") else app_dir() / ".debug" / profile_id / "cache"
    return {
        "profileId": profile_id,
        "configPath": str(config_path),
        "keysPath": str(keys_path),
        "cacheDir": str(cache_dir),
        "decryptedDir": str(cache_dir / "decrypted"),
        "decodedImageDir": str(cache_dir / "decoded_images"),
    }


def write_profile_config(args: argparse.Namespace) -> dict[str, str]:
    paths = profile_paths(args)
    config_path = Path(paths["configPath"])
    cache_dir = Path(paths["cacheDir"])
    config_path.parent.mkdir(parents=True, exist_ok=True)
    cache_dir.mkdir(parents=True, exist_ok=True)
    (cache_dir / "decrypted").mkdir(parents=True, exist_ok=True)
    (cache_dir / "decoded_images").mkdir(parents=True, exist_ok=True)
    (cache_dir / "tmp").mkdir(parents=True, exist_ok=True)
    config = {
        "db_dir": args.db_dir,
        "keys_file": paths["keysPath"],
        "decrypted_dir": paths["decryptedDir"],
        "decoded_image_dir": paths["decodedImageDir"],
    }
    if args.bundle_id:
        config["wechat_bundle_id"] = args.bundle_id
        config["wechat_container_id"] = args.bundle_id
    if args.app_path:
        config["wechat_app_path"] = args.app_path
    Path(paths["keysPath"]).parent.mkdir(parents=True, exist_ok=True)
    config_path.write_text(json.dumps(config, ensure_ascii=False, indent=2), encoding="utf-8")
    return paths


def run_init_profile(args: argparse.Namespace) -> int:
    if not args.db_dir:
        return envelope(
            False,
            data=None,
            error={"code": "WECHAT_DB_DIR_NOT_FOUND", "message": "缺少 db_dir，无法初始化微信Profile。", "recoverable": True},
        )
    db_dir = Path(os.path.expanduser(args.db_dir))
    if not db_dir.exists():
        return envelope(
            False,
            data=None,
            error={"code": "WECHAT_DB_DIR_NOT_FOUND", "message": "db_dir 不存在或不可访问。", "recoverable": True},
            profile_id=args.profile_id,
        )

    paths = write_profile_config(args)
    config = load_profile_config(paths["configPath"])
    cmd = [
        query_cli(config, args.cli_path),
        "init",
        "--config",
        paths["configPath"],
        "--keys-file",
        paths["keysPath"],
        "--db-dir",
        args.db_dir,
        "--force",
    ]
    if args.bundle_id:
        cmd.extend(["--bundle-id", args.bundle_id])
    if args.app_path:
        cmd.extend(["--app-path", args.app_path])
    if args.pid:
        cmd.extend(["--pid", str(args.pid)])

    password = sys.stdin.readline().rstrip("\n") if not sys.stdin.isatty() else ""
    sudo_ok, sudo_error = validate_sudo_password(password)
    if not sudo_ok:
        return envelope(
            False,
            data={**paths, "dbDir": str(db_dir)},
            error={
                "code": "WECHAT_SUDO_PASSWORD_INVALID",
                "message": f"电脑用户密码验证失败，无法继续签名和读取微信密钥。{sudo_error}",
                "recoverable": True,
            },
            profile_id=args.profile_id,
        )

    if platform.system() == "Darwin" and args.app_path:
        signing_state = read_wechat_signing_state(args.app_path)
        if signing_state.get("needsResign", True):
            resign_ok, resign_error = resign_wechat_with_merged_entitlements(args.app_path, bool(password))
            if not resign_ok:
                if is_wechat_codesign_permission_denied(resign_error):
                    return envelope(
                        False,
                        data={**paths, "dbDir": str(db_dir)},
                        error={
                            "code": "WECHAT_SIGN_PERMISSION_DENIED",
                            "message": "macOS 已阻止 IM-Board 修改微信应用，微信签名没有完成。请在系统提示“已阻止修改 Mac 上的 App”时选择允许；如果刚才点了不允许，请到 系统设置 > 隐私与安全性 > App 管理 允许 IM-Board。授权后继续开始绑定；签名成功后会自动重启微信并重新检测。底层返回：codesign Operation not permitted。",
                            "recoverable": True,
                        },
                        profile_id=args.profile_id,
                    )
                sign_message = f"微信自动签名没有完成。已尝试提取微信原始 entitlements、合并 get-task-allow 后重签。底层返回：{resign_error}"
                if is_wechat_codesign_permission_denied(resign_error):
                    sign_message = "macOS 已阻止 IM-Board 修改微信应用，微信签名没有完成。请到 系统设置 > 隐私与安全性 > App 管理 允许 IM-Board 后重试。底层返回：codesign Operation not permitted。"
                return envelope(
                    False,
                    data={**paths, "dbDir": str(db_dir)},
                    error={
                        "code": "WECHAT_SIGN_FAILED",
                        "message": sign_message,
                        "recoverable": True,
                    },
                    profile_id=args.profile_id,
                )
            restart_ok, restart_error = restart_wechat_app(args.app_path, args.bundle_id)
            restart_hint = (
                "微信已完成重新签名，并已自动重启微信和重新检测。请在微信窗口重新登录账号。"
                if restart_ok
                else f"微信已完成重新签名，但自动重启微信失败：{restart_error}。请手动重新打开微信并登录。"
            )
            return envelope(
                False,
                data={**paths, "dbDir": str(db_dir)},
                error={
                    "code": "WECHAT_RESTART_REQUIRED",
                    "message": restart_hint,
                    "recoverable": True,
                },
                profile_id=args.profile_id,
            )

    run_cmd = ["sudo", "-n", *cmd] if password else cmd
    try:
        proc = subprocess.run(
            run_cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        return envelope(
            False,
            data=None,
            error={"code": "WECHAT_CLI_MISSING", "message": f"微信 CLI 不可用：{sanitize(str(exc))}", "recoverable": True},
            profile_id=args.profile_id,
        )
    stderr = sanitize(proc.stderr)
    stdout = sanitize(proc.stdout)
    if proc.returncode != 0:
        combined_output = "\n".join([stderr, stdout])
        if is_wechat_codesign_permission_denied(combined_output):
            return envelope(
                False,
                data={**paths, "dbDir": str(db_dir)},
                error={
                    "code": "WECHAT_SIGN_PERMISSION_DENIED",
                    "message": "macOS 已阻止 IM-Board 修改微信应用，微信签名没有完成。请在系统提示“已阻止修改 Mac 上的 App”时选择允许；如果刚才点了不允许，请到 系统设置 > 隐私与安全性 > App 管理 允许 IM-Board。授权后继续开始绑定；签名成功后会自动重启微信并重新检测。底层返回：codesign Operation not permitted。",
                    "recoverable": True,
                },
                profile_id=args.profile_id,
            )
        return envelope(
            False,
            data=None,
            warnings=[line for line in [stderr, stdout] if line],
            error={"code": "WECHAT_KEY_SCAN_FAILED", "message": "微信配置或密钥初始化失败。", "recoverable": True},
            profile_id=args.profile_id,
        )

    # wechat_cli init may rewrite config.json. Restore the bridge-owned
    # Profile config so cache/decrypted/media paths remain isolated per Profile.
    paths = write_profile_config(args)

    for target in [Path(paths["configPath"]).parent, Path(paths["cacheDir"])]:
        if password and target.exists():
            subprocess.run(
                ["sudo", "-n", "chown", "-R", f"{os.environ.get('USER', '')}:staff", str(target)],
                text=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

    keys_size = Path(paths["keysPath"]).stat().st_size if Path(paths["keysPath"]).exists() else 0
    if keys_size <= 2:
        stats = db_dir_stats(db_dir)
        return envelope(
            False,
            data={**paths, "keysSize": keys_size},
            warnings=[
                f"密钥文件：{paths['keysPath']}（{keys_size} 字节）",
                f"db_storage：{db_dir}",
                f"db_storage 检测：session.db={stats['hasSessionDb']}，message.db={stats['hasMessageDb']}，contact.db={stats['hasContactDb']}，db文件数={stats['dbCount']}",
            ],
            error={
                "code": "WECHAT_KEYS_EMPTY",
                "message": "未读取到微信密钥。通常是微信重启后还没有重新登录账号，或选择的账号数据文件夹不是当前登录账号。请先在微信窗口完成登录，然后重试绑定。",
                "recoverable": True,
            },
            profile_id=args.profile_id,
        )
    stats = db_dir_stats(db_dir)
    matched_db_count = int(stats["hasSessionDb"]) + int(stats["hasMessageDb"]) + int(stats["hasContactDb"])
    return envelope(
        True,
        data={
            "profileId": args.profile_id,
            "success": True,
            "cliPath": cmd[0],
            "targetPid": args.pid,
            "scannedPid": args.pid,
            "appPath": args.app_path,
            "bundleId": args.bundle_id,
            "dbDir": str(db_dir),
            "matchedDbCount": matched_db_count,
            "totalDbCount": stats["dbCount"],
            "keysFileSize": keys_size,
            **paths,
        },
        profile_id=args.profile_id,
    )


def is_wechat_codesign_permission_denied(output: str) -> bool:
    normalized = output.lower()
    return "codesign" in normalized and (
        "operation not permitted" in normalized or "已阻止修改" in output
    )


def load_profile_config(config_path: str) -> dict[str, Any]:
    config: dict[str, Any] = {}
    try:
        loaded = json.loads(Path(config_path).read_text(encoding="utf-8"))
        if isinstance(loaded, dict):
            config.update(loaded)
    except Exception:
        pass
    try:
        env_config = json.loads(os.environ.get("IMD_PROFILE_CONFIG_JSON", "{}"))
        if isinstance(env_config, dict):
            config.update(env_config)
    except Exception:
        pass
    return config


def command_key(command: str) -> str:
    if command in ["list-chats", "sessions"]:
        return "listChats"
    if command in ["fetch-messages", "history", "fts-history"]:
        return "fetchMessages"
    return command


def default_cli_command(command: str) -> str:
    if command in ["list-chats", "sessions"]:
        return "sessions"
    if command in ["fetch-messages", "history", "fts-history"]:
        return "history"
    return command


def cli_command(config: dict[str, Any], command: str) -> str:
    commands = config.get("cliCommands")
    if isinstance(commands, dict):
        for key in [command_key(command), command, command.replace("-", "_")]:
            value = commands.get(key)
            if isinstance(value, str) and value.strip():
                return value.strip()
    return default_cli_command(command)


def cli_arg_name(config: dict[str, Any], command: str, arg_name: str) -> str:
    arg_maps = config.get("cliArgs")
    if isinstance(arg_maps, dict):
        command_args = arg_maps.get(command_key(command)) or arg_maps.get(command) or arg_maps.get(command.replace("-", "_"))
        if isinstance(command_args, dict):
            for key in [arg_name, arg_name.replace("_", "-"), camel_name(arg_name)]:
                value = command_args.get(key)
                if isinstance(value, str) and value.strip():
                    return value.strip().lstrip("-")
    return arg_name.replace("_", "-")


def cli_arg_placement(config: dict[str, Any], command: str, arg_name: str) -> str:
    placements = config.get("cliArgPlacement")
    if isinstance(placements, dict):
        command_args = placements.get(command_key(command)) or placements.get(command) or placements.get(command.replace("-", "_"))
        if isinstance(command_args, dict):
            value = command_args.get(arg_name) or command_args.get(camel_name(arg_name))
            if isinstance(value, str) and value.strip():
                return value.strip()
    return "positional" if command_key(command) == "fetchMessages" and arg_name == "chat" else "option"


def camel_name(name: str) -> str:
    parts = name.split("_")
    return parts[0] + "".join(part[:1].upper() + part[1:] for part in parts[1:])


def append_option(cli_args: list[str], config: dict[str, Any], command: str, arg_name: str, value: Any) -> None:
    cli_args.extend([f"--{cli_arg_name(config, command, arg_name)}", str(value)])


def run_wechat_cli(args: argparse.Namespace, command: str) -> int:
    if not args.config:
        return envelope(
            False,
            data=None,
            error={"code": "WECHAT_PROFILE_NOT_FOUND", "message": "缺少Profile config路径。", "recoverable": True},
        )
    config_path = str(Path(os.path.expanduser(args.config)).resolve())
    config = load_profile_config(config_path)
    actual_command = cli_command(config, command)
    cli_args = [query_cli(config, args.cli_path), "--config", config_path, actual_command]
    if command_key(command) == "listChats":
        if args.limit:
            append_option(cli_args, config, command, "limit", args.limit)
        cli_args.extend(["--format", "json"])
    elif command_key(command) == "fetchMessages":
        if not args.chat:
            return envelope(False, data=None, error={"code": "UNKNOWN_ERROR", "message": "fetch-messages缺少chat参数。", "recoverable": True})
        if cli_arg_placement(config, command, "chat") == "positional":
            cli_args.append(args.chat)
        else:
            append_option(cli_args, config, command, "chat", args.chat)
        for key in ["limit", "offset", "start_time", "end_time"]:
            value = getattr(args, key, None)
            if value is not None:
                append_option(cli_args, config, command, key, value)
        cli_args.extend(["--format", "json"])
    elif command == "search":
        if not args.query:
            return envelope(False, data=None, error={"code": "UNKNOWN_ERROR", "message": "search缺少query参数。", "recoverable": True})
        cli_args.append(args.query)
        if args.chat:
            cli_args.extend(["--chat", args.chat])
        if args.limit:
            cli_args.extend(["--limit", str(args.limit)])
        cli_args.extend(["--format", "json"])
    elif command == "stats":
        if args.chat:
            cli_args.append(args.chat)
        cli_args.extend(["--format", "json"])

    try:
        proc = subprocess.run(cli_args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    except FileNotFoundError as exc:
        return envelope(
            False,
            data=None,
            error={"code": "WECHAT_CLI_MISSING", "message": f"微信 CLI 不可用：{sanitize(str(exc))}", "recoverable": True},
        )
    if proc.returncode != 0:
        return envelope(
            False,
            data=None,
            warnings=[sanitize(proc.stderr or proc.stdout)],
            error={"code": "WECHAT_DECRYPT_FAILED", "message": f"wechat-cli {command} 执行失败。", "recoverable": True},
        )
    raw = proc.stdout.strip()
    try:
        data = json.loads(raw) if raw else []
    except json.JSONDecodeError:
        data = {"text": raw}
    return envelope(True, data=data, command=command)


def clear_cache(args: argparse.Namespace) -> int:
    paths = profile_paths(args)
    cache_dir = Path(paths["cacheDir"])
    if cache_dir.exists():
        shutil.rmtree(cache_dir)
    cache_dir.mkdir(parents=True, exist_ok=True)
    return envelope(True, data={"cacheDir": str(cache_dir)}, profile_id=args.profile_id)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command",
        choices=[
            "discover",
            "init-profile",
            "list-chats",
            "fetch-messages",
            "sessions",
            "history",
            "fts-history",
            "search",
            "stats",
            "clear-cache",
        ],
    )
    parser.add_argument("--format", default="json")
    parser.add_argument("--profile-id")
    parser.add_argument("--config")
    parser.add_argument("--keys-file")
    parser.add_argument("--pid", type=int)
    parser.add_argument("--bundle-id")
    parser.add_argument("--app-path")
    parser.add_argument("--db-dir")
    parser.add_argument("--cli-path")
    parser.add_argument("--chat")
    parser.add_argument("--chat-name")
    parser.add_argument("--chat-type")
    parser.add_argument("--query")
    parser.add_argument("--limit", type=int)
    parser.add_argument("--offset", type=int)
    parser.add_argument("--start-time")
    parser.add_argument("--end-time")
    return parser


def main() -> int:
    started = time.monotonic()
    load_local_env()
    args = build_parser().parse_args()
    try:
        if args.command == "discover":
            return envelope(True, data=discover_candidates(), duration_ms=int((time.monotonic() - started) * 1000))
        if args.command == "init-profile":
            return run_init_profile(args)
        if args.command == "clear-cache":
            return clear_cache(args)
        return run_wechat_cli(args, args.command)
    except Exception as exc:  # noqa: BLE001 - bridge should always return JSON
        return envelope(
            False,
            data=None,
            error={"code": "UNKNOWN_ERROR", "message": sanitize(str(exc)), "recoverable": True},
        )


if __name__ == "__main__":
    raise SystemExit(main())
