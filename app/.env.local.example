# Optional local overrides for real WeChat debugging.
# Copy to .env.local only when the auto-detection defaults are not enough.

# Source checkout that supports multi-instance init options such as
# --config, --keys-file, --bundle-id, --app-path and --pid.
IMD_WECHAT_SOURCE_DIR=/Users/chase/wechat-cli-work

# Query CLI used after a Profile has already been initialized.
IMD_WECHAT_QUERY_CLI=wechat-cli
